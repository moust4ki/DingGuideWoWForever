# Packaging for CurseForge (BigWigs packager, .github/workflows/release.yml).
# The addon lives in Ding/: its content becomes the root of the Ding folder of the zip.
# Only the addon (with its game data, Ding/DB, and its credits) and its license ship; tools,
# docs and the example guide pack stay out.
package-as: Ding

move-folders:
  Ding/Ding: Ding

ignore:
  - tools
  - docs
  - examples
  - README.md
  - CLAUDE.md

# Release notes on CurseForge and GitHub, written in English for players (the commit
# messages are in English too, but full of development notes). Add an entry before each tag.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# No hard dependency: Ding carries its own game data. TomTom is an optional alternative arrow.
optional-dependencies:
  - tomtom
